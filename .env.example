# RepoCompass Environment Configuration
# Copy this file to .env or .env.local to configure your local keys.
# NEVER commit your actual API keys or secrets to version control!

# Google Gemini API Key (Required for Gemma 4 AI synthesis)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma 4 Model Identifier
# Verified available Gemma 4 models in Google Gemini API:
# - gemma-4-31b-it   (Recommended: 31B instruction-tuned model)
# - gemma-4-26b-a4b-it (26B MoE instruction-tuned model)
GEMMA_MODEL=gemma-4-31b-it

# GitHub Personal Access Token (Optional)
# Increases GitHub REST API rate limit from 60 requests/hr to 5,000 requests/hr
# Generate at: https://github.com/settings/tokens (no special scopes needed for public repos)
GITHUB_TOKEN=your_github_personal_access_token_here

# Flask Server Port (Default: 5000)
PORT=5000
FLASK_DEBUG=false
